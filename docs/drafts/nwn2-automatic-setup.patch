+    if (Context.PlayerID === 0) {
+        var quotePS = function (value) { return "'" + value.replace(/'/g, "''") + "'"; };
+        var setupLog = Context.ScriptFolder + "\\setup.log";
+        var command = "$ErrorActionPreference='Stop'; try { & " +
